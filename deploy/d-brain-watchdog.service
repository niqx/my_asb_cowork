[Unit]
Description=d-brain Session Watchdog (keeps the persistent Claude session alive)
After=network.target d-brain-bot.service

[Service]
Type=simple
User=myuser
WorkingDirectory=/home/myuser/projects/my_asb_cowork
ExecStart=/home/myuser/.local/bin/uv run python -m d_brain.services.watchdog
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1
Environment=TMUX_TMPDIR=/tmp
# Recover (force_recover) only restarts the tmux session, never kills siblings.
KillMode=process
SuccessExitStatus=143 SIGTERM

[Install]
WantedBy=multi-user.target
