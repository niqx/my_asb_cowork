[Unit]
Description=d-brain Weekly Digest
After=network.target

[Service]
Type=oneshot
User=myuser
WorkingDirectory=/home/myuser/projects/my_asb_cowork
ExecStartPre=+/usr/bin/systemctl stop d-brain-bot
ExecStart=/home/myuser/.local/bin/uv run python scripts/weekly.py
ExecStopPost=+/usr/bin/systemctl start d-brain-bot
EnvironmentFile=/home/myuser/projects/my_asb_cowork/.env
StandardOutput=journal
StandardError=journal
TimeoutStartSec=900
