[Unit]
Description=d-brain daily self-diagnostic (canary + local checks, 🟢/🔴 to Telegram)
After=network.target d-brain-bot.service

[Service]
Type=oneshot
User=myuser
WorkingDirectory=/home/myuser/projects/my_asb_cowork
# get_settings() loads .env from WorkingDirectory (pydantic-settings), so no
# EnvironmentFile is needed — same as the watchdog unit.
ExecStart=/home/myuser/.local/bin/uv run python -m d_brain.services.doctor
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/myuser/.local/bin:/usr/local/bin:/usr/bin:/bin
