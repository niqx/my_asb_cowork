[Unit]
Description=d-brain Web Upload Portal
After=network.target d-brain-bot.service

[Service]
Type=simple
User=myuser
WorkingDirectory=/home/myuser/projects/my_asb_cowork
ExecStart=/home/myuser/.local/bin/uv run uvicorn d_brain.web.app:app --host 127.0.0.1 --port 8090 --workers 1
Restart=always
RestartSec=5
EnvironmentFile=/home/myuser/projects/my_asb_cowork/.env

[Install]
WantedBy=multi-user.target
